// Prisma schema — مصدر الحقيقة للجداول (مُستخرج من قاعدة الإنتاج عبر db pull)
// بعد تعديل المخطط: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivationCode {
  id                   String                 @id
  course_id            String
  code                 String                 @unique
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  used_at              DateTime?              @db.Timestamptz(6)
  used_by_user_id      String?
  Course               Course                 @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User                 User?                  @relation(fields: [used_by_user_id], references: [id], onUpdate: NoAction)
  ActivationCodeLesson ActivationCodeLesson[]
  ActivationCodeQuiz   ActivationCodeQuiz[]

  @@index([code])
  @@index([course_id])
  @@index([created_at])
}

model ActivationCodeLesson {
  activation_code_id String
  lesson_id          String
  ActivationCode     ActivationCode @relation(fields: [activation_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson             Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([activation_code_id, lesson_id])
  @@index([activation_code_id], map: "ActivationCodeLesson_code_idx")
  @@index([lesson_id], map: "ActivationCodeLesson_lesson_idx")
}

model ActivationCodeQuiz {
  activation_code_id String
  quiz_id            String
  ActivationCode     ActivationCode @relation(fields: [activation_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Quiz               Quiz           @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([activation_code_id, quiz_id])
  @@index([activation_code_id], map: "ActivationCodeQuiz_code_idx")
  @@index([quiz_id], map: "ActivationCodeQuiz_quiz_idx")
}

model Category {
  id            String   @id
  name          String
  name_ar       String?
  slug          String   @unique
  description   String?
  image_url     String?
  order         Int      @default(0)
  created_by_id String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  Course        Course[]
}

model Challenge {
  id                  String                @id
  title               String
  title_en            String?
  description         String?
  description_en      String?
  question_type       String                @default("MULTIPLE_CHOICE")
  options             Json?
  correct_answer      String
  is_active           Boolean               @default(true)
  sort_order          Int                   @default(0)
  created_by          String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  User                User?                 @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  ChallengeSubmission ChallengeSubmission[]

  @@index([is_active, sort_order], map: "Challenge_is_active_idx")
}

model ChallengeSubmission {
  id           String    @id
  user_id      String
  challenge_id String
  answer       String
  is_correct   Boolean   @default(false)
  submitted_at DateTime  @default(now()) @db.Timestamptz(6)
  Challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, challenge_id], map: "challenge_submission_unique_user_challenge")
  @@index([user_id])
}

model Conversation {
  id                                      String    @id
  staff_user_id                           String
  student_user_id                         String
  created_at                              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime  @default(now()) @db.Timestamptz(6)
  User_Conversation_staff_user_idToUser   User      @relation("Conversation_staff_user_idToUser", fields: [staff_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_Conversation_student_user_idToUser User      @relation("Conversation_student_user_idToUser", fields: [student_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Message                                 Message[]

  @@unique([staff_user_id, student_user_id])
  @@index([staff_user_id])
  @@index([student_user_id])
}

model Course {
  id                 String               @id
  title              String
  title_ar           String?
  slug               String               @unique
  description        String
  description_en     String?
  short_desc         String?              @db.VarChar(300)
  short_desc_en      String?              @db.VarChar(300)
  image_url          String?
  price              Decimal              @default(0) @db.Decimal(10, 2)
  duration           String?
  level              String?
  is_published       Boolean              @default(false)
  order              Int                  @default(0)
  max_quiz_attempts  Int?
  category_id        String?
  created_by_id      String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  accepts_homework   Boolean              @default(false)
  ActivationCode     ActivationCode[]
  Category           Category?            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  User               User?                @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  CourseCompletion   CourseCompletion[]
  Enrollment         Enrollment[]
  HomeworkSubmission HomeworkSubmission[]
  Lesson             Lesson[]
  LessonCompletion   LessonCompletion[]
  LessonRating       LessonRating[]
  LiveStream         LiveStream[]
  Payment            Payment[]
  PointEvent         PointEvent[]
  Quiz               Quiz[]
  QuizCompletion     QuizCompletion[]

  @@index([category_id])
  @@index([created_by_id])
  @@index([slug])
}

model CourseCompletion {
  id           String   @id
  user_id      String
  course_id    String
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  Course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id], map: "course_completion_unique_user_course")
  @@index([course_id])
  @@index([user_id])
}

model ElhawyWorldVideo {
  id              String   @id
  title           String
  title_en        String?
  description     String?
  description_en  String?
  youtube_url     String
  cover_image_url String?
  is_published    Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([is_published, sort_order, created_at(sort: Desc)], map: "ElhawyWorldVideo_published_sort_idx")
}

model Enrollment {
  id          String   @id
  user_id     String
  course_id   String
  enrolled_at DateTime @default(now()) @db.Timestamptz(6)
  Course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User        User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([course_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model GamificationPointRule {
  event_type String   @id
  points     Int
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

