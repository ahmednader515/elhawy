/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model HomeworkSubmission {
  id              String   @id
  course_id       String
  user_id         String
  submission_type String
  link_url        String?
  file_url        String?
  file_name       String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  lesson_id       String?
  Course          Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson          Lesson?  @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id])
  @@index([created_at])
  @@index([lesson_id])
  @@index([user_id])
}

model Lesson {
  id                   String                 @id
  course_id            String
  title                String
  title_ar             String?
  slug                 String
  content              String?
  video_url            String?
  pdf_url              String?
  duration             Int?
  order                Int                    @default(0)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  accepts_homework     Boolean                @default(false)
  ActivationCodeLesson ActivationCodeLesson[]
  HomeworkSubmission   HomeworkSubmission[]
  Course               Course                 @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  LessonCompletion     LessonCompletion[]
  LessonRating         LessonRating[]

  @@unique([course_id, slug])
  @@index([course_id])
}

model LessonCompletion {
  id           String   @id
  user_id      String
  lesson_id    String
  course_id    String
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  Course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, lesson_id], map: "lesson_completion_unique_user_lesson")
  @@index([course_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LessonRating {
  id         String   @id
  lesson_id  String
  user_id    String
  course_id  String
  rating     Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  Course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Lesson     Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, user_id], map: "lesson_rating_unique_lesson_user")
  @@index([course_id])
  @@index([lesson_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LiveStream {
  id               String   @id
  course_id        String
  title            String
  title_ar         String?
  provider         String
  meeting_url      String
  meeting_id       String?
  meeting_password String?
  scheduled_at     DateTime @db.Timestamptz(6)
  description      String?
  order            Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  Course           Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id])
  @@index([scheduled_at])
}

model LuckWheelSpin {
  id         String   @id
  user_id    String
  result_key String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Message {
  id              String       @id
  conversation_id String
  sender_id       String
  message_type    String
  content         String?
  file_url        String?
  file_name       String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  Conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id])
  @@index([created_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model PasswordChangeRequest {
  id                                               String    @id
  user_id                                          String
  new_password_hash                                String
  requested_identifier                             String?
  requested_old_password                           String?
  requested_new_password_plain                     String?
  status                                           String    @default("pending")
  created_at                                       DateTime  @default(now()) @db.Timestamptz(6)
  processed_at                                     DateTime? @db.Timestamptz(6)
  processed_by_id                                  String?
  User_PasswordChangeRequest_processed_by_idToUser User?     @relation("PasswordChangeRequest_processed_by_idToUser", fields: [processed_by_id], references: [id], onUpdate: NoAction)
  User_PasswordChangeRequest_user_idToUser         User      @relation("PasswordChangeRequest_user_idToUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)])
  @@index([status])
  @@index([user_id])
}

model Payment {
  id         String   @id
  user_id    String
  course_id  String
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  Course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at])
}

model PointEvent {
  id           String   @id
  user_id      String
  event_type   String
  reference_id String
  course_id    String?
  points       Int
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  Course       Course?  @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, event_type, reference_id], map: "point_event_unique_user_type_ref")
  @@index([course_id])
  @@index([created_at(sort: Desc)])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Question {
  id             String           @id
  quiz_id        String
  type           String
  question_text  String
  order          Int              @default(0)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  Quiz           Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  QuestionOption QuestionOption[]

  @@index([quiz_id])
}

model QuestionOption {
  id          String   @id
  question_id String
  text        String
  is_correct  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  Question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id])
}

model Quiz {
  id                 String               @id
  course_id          String
  title              String
  order              Int                  @default(0)
  time_limit_minutes Int?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  ActivationCodeQuiz ActivationCodeQuiz[]
  Question           Question[]
  Course             Course               @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  QuizAttempt        QuizAttempt[]
  QuizCompletion     QuizCompletion[]

  @@index([course_id])
}

model QuizAttempt {
  id              String   @id
  user_id         String
  quiz_id         String
  score           Int
  total_questions Int
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  Quiz            Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([user_id, quiz_id], map: "QuizAttempt_user_quiz_idx")
}

model QuizCompletion {
  id           String   @id
  user_id      String
  quiz_id      String
  course_id    String
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  Course       Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Quiz         Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, quiz_id], map: "quiz_completion_unique_user_quiz")
  @@index([course_id])
  @@index([user_id])
}

model ReferralRequest {
  id                                                  String    @id
  user_id                                             String    @unique(map: "referral_request_unique_user")
  student_name                                        String
  student_mobile                                      String
  student_email                                       String
  referrer_name                                       String
  referrer_mobile                                     String
  status                                              String    @default("PENDING")
  matched_referrer_user_id                            String?
  reviewed_by                                         String?
  reviewed_at                                         DateTime? @db.Timestamptz(6)
  admin_note                                          String?
  created_at                                          DateTime  @default(now()) @db.Timestamptz(6)
  User_ReferralRequest_matched_referrer_user_idToUser User?     @relation("ReferralRequest_matched_referrer_user_idToUser", fields: [matched_referrer_user_id], references: [id], onUpdate: NoAction)
  User_ReferralRequest_reviewed_byToUser              User?     @relation("ReferralRequest_reviewed_byToUser", fields: [reviewed_by], references: [id], onUpdate: NoAction)
  User_ReferralRequest_user_idToUser                  User      @relation("ReferralRequest_user_idToUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "ReferralRequest_status_idx")
}

model Review {
  id              String   @id
  text            String
  text_en         String?
  author_name     String
  author_title    String?
  author_title_en String?
  avatar_letter   String?
  image_url       String?
  order           Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([order])
}

model StoreProduct {
  id                String              @id
  title             String
  description       String              @default("")
  price             Decimal             @default(0) @db.Decimal(10, 2)
  image_url         String?
  pdf_url           String?
  is_active         Boolean             @default(true)
  sort_order        Int                 @default(0)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  cost_price        Decimal             @default(0) @db.Decimal(10, 2)
  UserStorePurchase UserStorePurchase[]

  @@index([is_active, sort_order, created_at(sort: Desc)], map: "StoreProduct_active_sort_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SubscriptionPlan {
  id                       String                     @id
  name                     String
  description              String                     @default("")
  image_url                String?
  duration_kind            String
  price                    Decimal                    @default(0) @db.Decimal(10, 2)
  is_active                Boolean                    @default(true)
